# Copie para .env nesta pasta e preencha no seu computador. O .env nunca vai para o Git (.gitignore).
# Supabase: Project Settings → API. A service_role dá acesso total ao banco: fica só aqui, nunca no navegador nem no chat.
SUPABASE_URL=https://ycbdilsmydvzezhlymty.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# O Hermes local (hermes gateway com o servidor de API ligado). A mesma chave do API_SERVER_KEY do ~/.hermes/.env.
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Opcional: HERMES_SINAIS_IA=off desliga as classificações dos Sinais (provedor hermes das Edge Functions).
