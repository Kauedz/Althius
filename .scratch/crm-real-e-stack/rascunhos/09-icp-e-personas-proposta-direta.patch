+    })
+    let avisos = 0
+    fonte.observar(() => avisos++)
+
+    await expect(fonte.decidirRevisao!('r1', 'rejeitada')).rejects.toThrow(
+      'Somente Administradores aprovam ou recusam revisões do ICP e das Personas.',
+    )
+    expect(chamadas).toEqual([['decide_workspace_memory_revision', { p_revision_id: 'r1', p_decision: 'recusada' }]])
+    expect(avisos).toBe(0)
+  })
+
+  it('traduz as recusas do banco e esconde as falhas técnicas', async () => {
+    const { fonte } = fonteDoBruno({
+      propose_workspace_memory_revision: ({ p_document }) => {
+        if (p_document === 'icp') throw recusa('23505', 'a pending revision already exists for this document')
+        throw new Error('Failed to fetch')
+      },
+    })
+
+    await expect(fonte.proporRevisao!('icp', { pedido: 'x', secoes: [] })).rejects.toThrow(
+      'Já existe uma proposta do ICP pendente. Aguarde a decisão de um Administrador.',
