+
+/**
+ * A Memória do Workspace Norte como as funções do banco a guardam, entre sessões: Marina é Administradora e Bruno é
+ * Membro. As regras são do banco (pgTAP `memoria_do_workspace.sql`); aqui ele guarda o que as funções gravariam e recusa
+ * como elas recusam o que a tela ainda consegue pedir. `falhas` faz as próximas gravações caírem como uma queda de rede.
+ */
+function bancoDoNorte({ documentos = [] as DocumentoNoBanco[], revisoes = [] as RevisaoNoBanco[] } = {}) {
+  const banco = { documentos: [...documentos], revisoes: [...revisoes], falhas: 0, sessao: MARINA as Pessoa }
+  let instante = Date.parse('2026-09-28T12:00:00Z')
+  const agora = () => new Date((instante += 60_000)).toISOString()
+
+  function gravar<T>(aplicar: () => T): T {
+    if (banco.falhas > 0) {
+      banco.falhas--
+      throw new Error('Failed to fetch')
+    }
+    return aplicar()
+  }
+
+  const rpcs: Record<string, (p: Record<string, unknown>) => unknown> = {
+    bootstrap_personal_workspace: () => ({ id: `ws-pessoal-${banco.sessao.id}`, kind: 'pessoal', name: banco.sessao.nome, owner_user_id: banco.sessao.id }),
+    list_workspace_participants: () =>
+      [MARINA, BRUNO].map((p) => ({ user_id: p.id, email: p.email, name: p.nome, role: p.role, is_owner: false })),
+    list_workspace_invitations: () => [],
+    get_workspace_memory: () => banco.documentos,
+    list_workspace_memory_revisions: () => [...banco.revisoes].sort((a, b) => b.requested_at.localeCompare(a.requested_at)),
+    propose_workspace_memory_revision: ({ p_document, p_request, p_sections }) =>
+      gravar(() => {
+        if (banco.revisoes.some((r) => r.document === p_document && r.status === 'pendente')) {
+          throw recusa('23505', 'a pending revision already exists for this document')
+        }
+        const id = `revisao-${banco.revisoes.length + 1}`
+        banco.revisoes.push({
+          id, document: String(p_document), status: 'pendente', request: String(p_request),
+          proposed_sections: p_sections as Secoes, requested_by: banco.sessao.id, requested_by_name: banco.sessao.nome,
+          requested_at: agora(), decided_by: null, decided_by_name: null, decided_at: null,
+        })
+        return id
+      }),
+    decide_workspace_memory_revision: ({ p_revision_id, p_decision }) =>
+      gravar(() => {
+        if (banco.sessao.role !== 'admin') throw recusa('42501', 'only administrators decide memory revisions')
+        const revisao = banco.revisoes.find((r) => r.id === p_revision_id)!
+        if (revisao.status !== 'pendente') throw recusa('22023', 'revision already decided')
+        const decididaEm = agora()
+        if (p_decision === 'aprovada') {
+          banco.documentos = [
+            ...banco.documentos.filter((d) => d.document !== revisao.document),
+            { document: revisao.document, sections: revisao.proposed_sections!, approved_at: decididaEm, approved_by: banco.sessao.id, approved_by_name: banco.sessao.nome },
+          ]
+        }
+        Object.assign(revisao, {
+          status: p_decision, proposed_sections: null, decided_by: banco.sessao.id, decided_by_name: banco.sessao.nome, decided_at: decididaEm,
+        })
+        return null
+      }),
+  }
+  return Object.assign(banco, { rpcs })
+}
