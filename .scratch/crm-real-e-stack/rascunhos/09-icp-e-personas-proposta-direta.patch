+} from '@/fonte/regras-memoria'
+import type {
+  Decisao,
+  DocumentoDaMemoria,
+  DocumentoVigente,
+  Papel,
+  RevisaoDoParticipante,
+  SecaoDoDocumento,
+} from '@/fonte/tipos'
+import { mensagemDeErro } from '@/lib/utils'
+import { AbasDasPaginas, Bloco, SecaoDeConfiguracoes } from './componentes'
+
+const PAGINAS = Object.fromEntries(Object.entries(DOCUMENTOS_DA_MEMORIA).map(([id, { nome }]) => [id, nome]))
+
+/** As seções que os módulos leem do ICP: a proposta do primeiro ICP já começa com elas, sem texto. */
+const SECOES_SUGERIDAS_DO_ICP = ['Segmentos', 'Porte', 'Maturidade de dados', 'Regiões']
+
+/** Os rótulos do editor de seções: no ICP, seções com título e texto; nas Personas, uma Persona por seção. */
+const EDITOR: Record<
+  DocumentoDaMemoria,
+  { titulo: string; texto: string; item: string; adicionar: string; semTexto: string; semTitulo: string; repetido: string; dica: string }
+> = {
+  icp: {
+    titulo: 'Título da seção',
+    texto: 'Texto da seção',
+    item: 'seção',
+    adicionar: 'Adicionar seção',
+    semTexto: 'Escreva o texto de ao menos uma seção.',
+    semTitulo: 'Dê um título a cada seção com texto.',
+    repetido: 'Duas seções não podem ter o mesmo título',
+    dica: 'Seções sem texto ficam de fora.',
+  },
+  personas: {
+    titulo: 'Nome da Persona',
+    texto: 'Definição da Persona',
+    item: 'Persona',
+    adicionar: 'Adicionar Persona',
+    semTexto: 'Escreva a definição de ao menos uma Persona.',
+    semTitulo: 'Dê um nome a cada Persona com definição.',
+    repetido: 'Duas Personas não podem ter o mesmo nome',
+    dica: 'Personas sem definição ficam de fora.',
+  },
+}
+
+/** "O Workspace continua sem ICP aprovado." ou "O ICP vigente não mudou.": o que uma recusa ou pendência preserva. */
+function nadaMudou(documento: DocumentoDaMemoria, vigente: DocumentoVigente | null) {
+  const { nome } = DOCUMENTOS_DA_MEMORIA[documento]
+  const { concordar, oVigente, naoMudou } = frasesDo(documento)
+  return vigente
+    ? `${maiuscula(oVigente)} ${naoMudou}.`
+    : `O Workspace continua sem ${nome} ${concordar('aprovado', 'aprovadas')}.`
+}
+
+/**
+ * Memória do Workspace no Workspace operacional: o ICP e as Personas vigentes, guardados no backend como configuração
+ * do Workspace, e as propostas. Os Agentes ainda não rodam aqui, então o participante escreve a proposta; ela só vale
+ * depois que um Administrador a aprova nesta mesma página, porque a fila de Aprovações ainda não tem backend. Nada
+ * aqui vem de roteiro da Demonstração.
+ */
+export function SecaoMemoriaDoWorkspaceOperacional() {
+  const { pagina: documento } = useParams()
+  const fonte = useFonte()
+  const memoria = useCarregamento(fonte, (f) => f.memoriaDoWorkspace(), [])
+  const revisoes = useCarregamento(fonte, (f) => f.revisoesDaMemoria?.() ?? Promise.resolve([]), [])
+  // O papel da sessão decide se a proposta pendente mostra a decisão ou a quem ela cabe.
+  const workspace = useDados((f) => f.workspace(), [])
+  if (!ehDocumentoDaMemoria(documento)) return <Navigate to="/configuracoes/memoria/icp" replace />
+  const erro = memoria.erro ?? revisoes.erro
+
+  return (
+    <SecaoDeConfiguracoes
+      id="memoria-do-workspace"
+      titulo="Memória do Workspace"
+      alcance="workspace"
+      descricao="O ICP e as Personas deste Workspace, a referência compartilhada por todos os participantes. Qualquer participante propõe uma mudança, e ela só vale depois da aprovação de um Administrador."
+    >
+      <AbasDasPaginas secao="memoria" paginas={PAGINAS} rotuloAcessivel="Documentos da Memória do Workspace" />
+      <p role="note" className="border border-dashed border-al-line px-4 py-3 text-sm text-al-muted">
+        Os Agentes Scopus e Ethos ainda não rodam neste Workspace. Enquanto isso, um participante escreve a proposta, e a
+        decisão de um Administrador fica nesta página, porque a fila de Aprovações também ainda não está disponível aqui.
+      </p>
+      {erro ? (
+        <div className="flex flex-wrap items-center gap-3">
+          <Mensagem tipo="erro">{erro.message}</Mensagem>
+          <Button
+            type="button"
+            variant="outline"
+            onClick={() => {
+              memoria.recarregar()
+              revisoes.recarregar()
+            }}
+          >
+            Tentar de novo
+          </Button>
+        </div>
+      ) : !memoria.dados || !revisoes.dados || !workspace ? (
+        <Carregando />
+      ) : (
+        <DocumentoOperacional
+          key={documento}
+          documento={documento}
+          vigente={memoria.dados[documento]}
+          revisoes={revisoes.dados.filter((r) => r.documento === documento)}
+          papel={workspace.papel}
+        />
+      )}
+    </SecaoDeConfiguracoes>
+  )
+}
+
+function DocumentoOperacional({
+  documento,
+  vigente,
+  revisoes,
+  papel,
+}: {
+  documento: DocumentoDaMemoria
+  vigente: DocumentoVigente | null
+  /** As revisões deste documento, da mais nova para a mais antiga. */
+  revisoes: RevisaoDoParticipante[]
+  papel: Papel | null
+}) {
+  const [propondo, setPropondo] = useState(false)
+  const [resultado, setResultado] = useState('')
+  const { nome, oNome, comArtigo } = DOCUMENTOS_DA_MEMORIA[documento]
+  const { concordar, oVigente, foiSubstituido } = frasesDo(documento)
+  const pendente = revisoes.find((r) => r.estado === 'pendente')
+  const ultimaDecidida = revisoes.find((r) => r.estado !== 'pendente')
+  const recusada = !pendente && ultimaDecidida?.estado === 'rejeitada' ? ultimaDecidida : undefined
+  const rotuloDaProposta = vigente ? `Propor revisão ${comArtigo}` : `Propor ${oNome}`
+
+  function aoDecidir(decisao: Decisao) {
+    setResultado(
+      decisao === 'aprovada'
+        ? vigente
+          ? `Proposta aprovada. ${maiuscula(oVigente)} ${foiSubstituido} para todo o Workspace.`
+          : `Proposta aprovada. ${maiuscula(oNome)} ${concordar('passou', 'passaram')} a valer para todo o Workspace.`
+        : '',
+    )
+  }
+
+  return (
+    <>
+      <section aria-label={`${nome} ${concordar('vigente', 'vigentes')}`} className="flex flex-col gap-6">
+        <div className="flex items-start justify-between gap-6">
+          <div className="flex flex-col gap-1">
+            <div className="flex items-center gap-3">
+              <h3 className="titulo-secao text-2xl">{nome}</h3>
+              {vigente && (
+                <span className="selo border-al-sucesso/60 text-al-ink">
+                  <span className="size-1.5 rounded-full bg-al-sucesso" aria-hidden />
+                  Vigente
+                </span>
+              )}
+            </div>
+            {vigente && (
+              <span className="text-sm text-al-muted">
+                {concordar('Aprovado', 'Aprovadas')} em {formatarDiaIsoPorExtenso(vigente.aprovadoEm)} por{' '}
+                {vigente.aprovadoPor.nome}
+              </span>
+            )}
+          </div>
+          {!pendente && (
+            <button
+              type="button"
+              onClick={() => {
+                setResultado('')
+                setPropondo(true)
+              }}
+              className={BOTAO_PRIMARIO}
+            >
+              {rotuloDaProposta}
+            </button>
+          )}
+        </div>
+
+        <Mensagem tipo="sucesso">{resultado}</Mensagem>
+        {recusada && (
+          <Mensagem tipo="info">
+            A última proposta, de {recusada.solicitante.nome}, foi recusada por {recusada.decididaPor.nome}.{' '}
+            {nadaMudou(documento, vigente)}
+          </Mensagem>
+        )}
+
+        {vigente ? (
+          <SecoesDoDocumento secoes={vigente.secoes} className="cartao gap-y-4 p-6" />
+        ) : (
+          <div className="cartao flex flex-col gap-2 p-6">
+            <p>
+              Este Workspace ainda não tem {nome} {concordar('aprovado', 'aprovadas')}.
+            </p>
+            <p className="text-sm text-al-muted">
+              {documento === 'icp'
+                ? 'O ICP descreve o perfil de cliente ideal: segmentos, porte, maturidade e regiões em que a empresa vende melhor.'
+                : 'Cada Persona descreve um papel do Comitê de compra. As Personas classificam os Contatos e não são participantes do Workspace.'}
+            </p>
+          </div>
+        )}
+        {vigente && documento === 'personas' && (
+          <p className="text-sm text-al-muted">
+            Cada Persona descreve um papel do Comitê de compra. As Personas classificam os Contatos e não são participantes
+            do Workspace.
+          </p>
+        )}
+        <p className="text-sm text-al-muted">
+          A Memória do Workspace guarda só o documento vigente: não há histórico nem restauração, e {oNome} só{' '}
+          {concordar('muda', 'mudam')} por uma proposta aprovada.
+        </p>
+      </section>
+
+      {pendente && (
+        <PropostaPendente revisao={pendente} vigente={vigente} papel={papel} aoDecidir={aoDecidir} />
+      )}
+
+      <Bloco
+        titulo="Onde este contexto é usado"
+        descricao={`Nenhum módulo deste Workspace lê ${oNome} ainda. Quando chegarem aqui, estas configurações vão ler ${oVigente} desta página, sem cópia e sem novas aprovações por módulo.`}
+      >
+        <ListaDeDependentes
+          dependentes={dependentesDe(documento, vigente?.secoes ?? []).map((d) => (vigente ? d : { ...d, resumo: '' }))}
+          rotuloAcessivel={`Configurações que vão usar ${oNome}`}
+          situacao={<span className="text-xs text-al-muted">Ainda não disponível neste Workspace</span>}
+        />
+      </Bloco>
+
+      {propondo && (
+        <DialogoDeProposta
+          documento={documento}
+          vigente={vigente}
+          titulo={rotuloDaProposta}
+          aoFechar={() => setPropondo(false)}
