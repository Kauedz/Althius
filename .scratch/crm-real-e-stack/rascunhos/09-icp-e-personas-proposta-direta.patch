+import { describe, expect, it } from 'vitest'
+import { criarSupabaseFalso, sessaoDe } from '@/test/supabase-falso'
+import { criarFonteDaMemoriaSupabase } from './supabase-memoria'
+
+const BRUNO = { id: 'usuario-bruno', email: 'bruno@norte.com.br' }
+
+/** Uma recusa do banco, com o SQLSTATE e a mensagem que a função levanta. */
+function recusa(code: string, message: string) {
+  return Object.assign(new Error(message), { code })
+}
+
+/** A Memória do Norte pelo Bruno, Membro, com as chamadas que chegaram ao banco em `chamadas`. */
+function fonteDoBruno(rpcs: Record<string, (p: Record<string, unknown>) => unknown>) {
+  const chamadas: [string, Record<string, unknown>][] = []
+  const registradas = Object.fromEntries(
+    Object.entries(rpcs).map(([nome, responder]) => [
+      nome,
+      (p: Record<string, unknown>) => {
+        chamadas.push([nome, p])
+        return responder(p)
+      },
+    ]),
+  )
+  const { cliente } = criarSupabaseFalso({ sessao: sessaoDe(BRUNO), rpcs: registradas })
+  return { fonte: criarFonteDaMemoriaSupabase(cliente, 'ws-norte'), chamadas }
+}
+
+const ICP_NO_BANCO = {
+  document: 'icp',
+  sections: [{ titulo: 'Segmentos', texto: 'Varejo.' }],
+  approved_at: '2026-09-20T15:00:00Z',
+  approved_by: 'usuario-marina',
+  approved_by_name: 'Marina Souza',
+}
+
+describe('Memória do Workspace operacional', () => {
+  it('lê os documentos vigentes do Workspace; o que não foi aprovado vem vazio', async () => {
+    const { fonte, chamadas } = fonteDoBruno({ get_workspace_memory: () => [ICP_NO_BANCO] })
+
+    expect(await fonte.memoriaDoWorkspace()).toEqual({
+      icp: {
+        secoes: [{ titulo: 'Segmentos', texto: 'Varejo.' }],
+        aprovadoEm: '2026-09-20',
+        aprovadoPor: { contaId: 'usuario-marina', nome: 'Marina Souza' },
+      },
+      personas: null,
+    })
+    expect(chamadas).toEqual([['get_workspace_memory', { p_workspace_id: 'ws-norte' }]])
+  })
+
+  it('a revisão pendente traz o proposto e o vigente; a decidida, só quem pediu e quem decidiu', async () => {
+    const { fonte } = fonteDoBruno({
+      get_workspace_memory: () => [ICP_NO_BANCO],
+      list_workspace_memory_revisions: () => [
+        {
+          id: 'r2', document: 'icp', status: 'pendente', request: 'Atacado.',
+          proposed_sections: [{ titulo: 'Segmentos', texto: 'Atacado.' }], requested_by: BRUNO.id,
+          requested_by_name: 'Bruno Reis', requested_at: '2026-09-27T12:00:00Z',
+          decided_by: null, decided_by_name: null, decided_at: null,
+        },
+        {
+          id: 'r1', document: 'personas', status: 'recusada', request: 'Comitê.', proposed_sections: null,
+          requested_by: BRUNO.id, requested_by_name: 'Bruno Reis', requested_at: '2026-09-26T12:00:00Z',
+          decided_by: 'usuario-marina', decided_by_name: 'Marina Souza', decided_at: '2026-09-26T13:00:00Z',
+        },
+      ],
+    })
+
+    expect(await fonte.revisoesDaMemoria!()).toEqual([
+      {
+        id: 'r2', documento: 'icp', estado: 'pendente', pedido: 'Atacado.', pedidaEm: '2026-09-27',
+        solicitante: { contaId: BRUNO.id, nome: 'Bruno Reis' },
+        proposto: [{ titulo: 'Segmentos', texto: 'Atacado.' }],
+        vigenteNoPedido: [{ titulo: 'Segmentos', texto: 'Varejo.' }],
+      },
+      {
+        id: 'r1', documento: 'personas', estado: 'rejeitada', pedido: 'Comitê.', pedidaEm: '2026-09-26',
+        solicitante: { contaId: BRUNO.id, nome: 'Bruno Reis' },
+        decididaPor: { contaId: 'usuario-marina', nome: 'Marina Souza' },
+      },
+    ])
+  })
+
+  it('propõe o documento inteiro, sem espaços nas pontas, e avisa quem observa', async () => {
+    const { fonte, chamadas } = fonteDoBruno({ propose_workspace_memory_revision: () => 'r1' })
+    let avisos = 0
+    fonte.observar(() => avisos++)
+
+    await fonte.proporRevisao!('personas', { pedido: ' Comitê. ', secoes: [{ titulo: ' Comprador ', texto: ' Negocia. ' }] })
+
+    expect(chamadas).toEqual([
+      [
+        'propose_workspace_memory_revision',
+        { p_workspace_id: 'ws-norte', p_document: 'personas', p_request: 'Comitê.', p_sections: [{ titulo: 'Comprador', texto: 'Negocia.' }] },
+      ],
+    ])
+    expect(avisos).toBe(1)
+  })
+
+  it('um Membro não decide: a recusa do banco chega como a regra, e nada é avisado', async () => {
+    const { fonte, chamadas } = fonteDoBruno({
+      decide_workspace_memory_revision: () => {
+        throw recusa('42501', 'only administrators decide memory revisions')
