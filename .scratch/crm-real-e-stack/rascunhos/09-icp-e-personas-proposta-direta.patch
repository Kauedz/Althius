+              `Proposta enviada para a decisão de um Administrador. Até lá, ${
+                vigente
+                  ? `${oVigente} ${concordar('continua', 'continuam')} valendo.`
+                  : `o Workspace continua sem ${nome} ${concordar('aprovado', 'aprovadas')}.`
+              }`,
+            )
+          }}
+        />
+      )}
+    </>
+  )
+}
+
+/** A proposta pendente: o motivo, quem pediu, o que muda e, para um Administrador, a decisão. */
+function PropostaPendente({
+  revisao,
+  vigente,
+  papel,
+  aoDecidir,
+}: {
+  revisao: Extract<RevisaoDoParticipante, { estado: 'pendente' }>
+  vigente: DocumentoVigente | null
+  papel: Papel | null
+  aoDecidir: (decisao: Decisao) => void
+}) {
+  const { comArtigo, oNome } = DOCUMENTOS_DA_MEMORIA[revisao.documento]
+  const { oVigente } = frasesDo(revisao.documento)
+  const { proposto, vigenteNoPedido } = revisao
+  const mudancas = secoesAlteradas(vigenteNoPedido, proposto)
+  const semMudanca = proposto.filter((s) => !mudancas.includes(s)).map((s) => s.titulo)
+  const saem = vigenteNoPedido.filter((s) => !proposto.some((p) => p.titulo === s.titulo)).map((s) => s.titulo)
+
+  return (
+    <article aria-label={`Proposta pendente ${comArtigo}`} className="cartao flex flex-col gap-5 border-al-atencao/50 p-6">
+      <div className="flex flex-wrap items-center gap-3">
+        <span className="selo border-al-atencao/60 text-al-atencao">
+          <Clock strokeWidth={1.8} className="size-3.5" aria-hidden />
+          Proposta pendente
+        </span>
+        <span className="rotulo">
+          Proposta de {revisao.solicitante.nome} · {formatarDiaIsoPorExtenso(revisao.pedidaEm)}
+        </span>
+      </div>
+      <dl className="grid grid-cols-[8rem_1fr] gap-x-6 gap-y-2">
+        <dt className="rotulo">Motivo</dt>
+        <dd>{revisao.pedido}</dd>
+      </dl>
+
+      <section aria-label="Alterações propostas" className="flex flex-col gap-3">
+        <h4 className="rotulo">Alterações propostas</h4>
+        <ul className="flex flex-col gap-3">
+          {mudancas.map((secao) => {
+            const antes = vigenteNoPedido.find((s) => s.titulo === secao.titulo)
+            return (
+              <li key={secao.titulo} className="grid grid-cols-[12rem_1fr] gap-x-6 border-l-2 border-al-accent pl-4">
+                <span className="flex items-start gap-2 font-normal">
+                  {secao.titulo}
+                  {!antes && vigente && <span className="selo h-5 border-al-accent/60 text-al-ink">Nova</span>}
+                </span>
+                <div className="flex flex-col gap-1">
+                  {antes && (
+                    <p className="text-sm text-al-muted line-through decoration-al-muted/60">
+                      <span className="sr-only">Vigente: </span>
+                      {antes.texto}
+                    </p>
+                  )}
+                  <p>
+                    <span className="sr-only">Proposto: </span>
+                    {secao.texto}
+                  </p>
+                </div>
+              </li>
+            )
+          })}
+        </ul>
+        {saem.length > 0 && <p className="text-sm text-al-muted">Sai do documento: {saem.join(', ')}.</p>}
+        {semMudanca.length > 0 && <p className="text-sm text-al-muted">Sem mudança: {semMudanca.join(', ')}.</p>}
+      </section>
+
+      <p className="border-t border-al-line pt-4 text-sm">
+        {vigente
+          ? `Aprovar substitui ${oVigente} para todo o Workspace, numa mudança só. Recusar mantém ${oNome} como está.`
+          : `Aprovar publica ${oNome} para todo o Workspace. Até a decisão, nada muda.`}
+      </p>
+      <DecisaoDaProposta revisaoId={revisao.id} papel={papel} aoDecidir={aoDecidir} />
+    </article>
+  )
+}
+
+function DecisaoDaProposta({
+  revisaoId,
+  papel,
+  aoDecidir,
+}: {
+  revisaoId: string
+  papel: Papel | null
+  aoDecidir: (decisao: Decisao) => void
+}) {
+  const fonte = useFonte()
+  const [erro, setErro] = useState('')
+  const [decidindo, setDecidindo] = useState(false)
+
+  if (!papel || !podeDecidir('revisao-da-memoria', papel)) return <AguardandoAdministrador />
+
+  async function decidir(decisao: Decisao) {
+    setErro('')
+    setDecidindo(true)
+    try {
+      if (!fonte.decidirRevisao) throw new Error(ERRO_SO_ADMINISTRADOR_DECIDE_REVISAO)
+      await fonte.decidirRevisao(revisaoId, decisao)
+      aoDecidir(decisao)
+    } catch (e) {
+      setErro(mensagemDeErro(e))
+    } finally {
+      setDecidindo(false)
+    }
+  }
+
+  return (
+    <div className="flex flex-col gap-3">
+      <div className="flex gap-2">
+        <Button disabled={decidindo} onClick={() => decidir('aprovada')} className="px-6 tracking-rotulo uppercase">
+          Aprovar
+        </Button>
+        <Button
+          variant="outline"
+          disabled={decidindo}
+          onClick={() => decidir('rejeitada')}
+          className="px-6 tracking-rotulo uppercase"
+        >
+          Recusar
+        </Button>
+      </div>
+      {erro && <Mensagem tipo="erro">{erro}</Mensagem>}
+    </div>
+  )
+}
+
+/** O que um Membro vê: a decisão cabe a um Administrador, e a tela diz a quem. */
+function AguardandoAdministrador() {
+  const dados = useDados((fonte) => fonte.participantesDoWorkspace(), [])
+  const administradores =
+    dados?.participantes.filter((p) => podeDecidir('revisao-da-memoria', p.papel)).map((p) => p.conta.nome) ?? []
+  return (
+    <Mensagem tipo="info">
+      {ERRO_SO_ADMINISTRADOR_DECIDE_REVISAO}
+      {administradores.length > 0 && ` Aguardando: ${administradores.join(' ou ')}.`}
+    </Mensagem>
+  )
+}
+
+interface SecaoEmEdicao extends SecaoDoDocumento {
+  chave: number
+}
+
+/** O diálogo em que o participante escreve o documento inteiro como deveria ficar, com o motivo. */
+function DialogoDeProposta({
+  documento,
+  vigente,
+  titulo,
+  aoFechar,
+  aoEnviar,
+}: {
+  documento: DocumentoDaMemoria
+  vigente: DocumentoVigente | null
+  titulo: string
+  aoFechar: () => void
+  aoEnviar: () => void
+}) {
+  const fonte = useFonte()
+  const { oNome } = DOCUMENTOS_DA_MEMORIA[documento]
+  const { concordar } = frasesDo(documento)
+  const rotulos = EDITOR[documento]
+  const iniciais: SecaoDoDocumento[] =
+    vigente?.secoes ??
+    (documento === 'icp' ? SECOES_SUGERIDAS_DO_ICP.map((t) => ({ titulo: t, texto: '' })) : [{ titulo: '', texto: '' }])
+  const [secoes, setSecoes] = useState<SecaoEmEdicao[]>(() => iniciais.map((s, chave) => ({ ...s, chave })))
+  const [proximaChave, setProximaChave] = useState(iniciais.length)
+  const [motivo, setMotivo] = useState('')
+  const [erro, setErro] = useState('')
+  const [enviando, setEnviando] = useState(false)
+
+  function mudar(chave: number, campo: 'titulo' | 'texto', valor: string) {
+    setSecoes((atuais) => atuais.map((s) => (s.chave === chave ? { ...s, [campo]: valor } : s)))
+  }
+
+  /** O documento proposto, ou o motivo de ainda não poder enviar. */
+  function conferir(): SecaoDoDocumento[] | string {
+    if (!motivo.trim()) return 'Conte por que propõe esta mudança.'
+    const comTexto = secoes
+      .map(({ titulo, texto }) => ({ titulo: titulo.trim(), texto: texto.trim() }))
+      .filter((s) => s.texto)
+    if (comTexto.some((s) => !s.titulo)) return rotulos.semTitulo
+    if (comTexto.length === 0) return rotulos.semTexto
+    const vistos = new Set<string>()
+    for (const { titulo } of comTexto) {
+      if (vistos.has(titulo.toLowerCase())) return `${rotulos.repetido}: ${titulo}.`
+      vistos.add(titulo.toLowerCase())
+    }
+    if (vigente && JSON.stringify(comTexto) === JSON.stringify(vigente.secoes)) {
+      return 'A proposta é igual ao documento vigente. Mude alguma seção antes de enviar.'
+    }
+    return comTexto
+  }
+
+  async function enviar(evento: FormEvent) {
+    evento.preventDefault()
+    const conferido = conferir()
+    if (typeof conferido === 'string') {
+      setErro(conferido)
+      return
+    }
+    setErro('')
+    setEnviando(true)
+    try {
+      if (!fonte.proporRevisao) throw new Error('Não é possível propor por aqui.')
+      await fonte.proporRevisao(documento, { pedido: motivo, secoes: conferido })
+      aoEnviar()
+    } catch (e) {
+      setErro(mensagemDeErro(e))
+      setEnviando(false)
+    }
+  }
+
+  return (
+    <Dialog open onOpenChange={(aberto) => !aberto && !enviando && aoFechar()}>
+      <DialogContent className="max-h-[90vh] gap-5 overflow-y-auto p-6 sm:max-w-2xl">
+        <DialogTitle className="titulo-secao text-2xl">{titulo}</DialogTitle>
+        <DialogDescription className="text-al-muted">
+          Escreva {oNome} como {concordar('deveria ficar', 'deveriam ficar')}. A proposta vai para a decisão de um
+          Administrador; até lá, nada muda para o Workspace.
+        </DialogDescription>
+        <form noValidate onSubmit={enviar} className="flex flex-col gap-5">
+          <div className="flex flex-col gap-2">
+            <label htmlFor="motivo-da-proposta" className="rotulo">
+              Por que propor esta mudança?
+            </label>
+            <textarea
+              id="motivo-da-proposta"
+              rows={2}
+              maxLength={2000}
+              value={motivo}
+              onChange={(e) => setMotivo(e.target.value)}
+              className="campo"
+            />
+          </div>
+
+          <fieldset className="flex flex-col gap-4">
+            <legend className="rotulo mb-2">
+              {maiuscula(oNome)} {concordar('proposto', 'propostas')}
+            </legend>
+            {secoes.map((secao, indice) => {
+              const numero = indice + 1
+              return (
+                <div key={secao.chave} className="flex flex-col gap-2 border-l-2 border-al-line pl-4">
+                  <div className="flex items-center gap-2">
+                    <input
+                      aria-label={`${rotulos.titulo} ${numero}`}
+                      value={secao.titulo}
+                      maxLength={120}
+                      onChange={(e) => mudar(secao.chave, 'titulo', e.target.value)}
+                      placeholder={rotulos.titulo}
+                      className="campo flex-1"
+                    />
+                    <button
+                      type="button"
+                      aria-label={`Remover ${rotulos.item} ${numero}`}
+                      onClick={() => setSecoes((atuais) => atuais.filter((s) => s.chave !== secao.chave))}
+                      className="p-2 text-al-muted hover:text-al-ink"
+                    >
+                      <Trash2 strokeWidth={1.8} className="size-4" aria-hidden />
+                    </button>
+                  </div>
+                  <textarea
+                    aria-label={`${rotulos.texto} ${numero}`}
+                    rows={2}
+                    maxLength={4000}
+                    value={secao.texto}
+                    onChange={(e) => mudar(secao.chave, 'texto', e.target.value)}
+                    className="campo"
+                  />
+                </div>
+              )
+            })}
+            <div className="flex items-center justify-between gap-3">
+              <button
+                type="button"
+                onClick={() => {
+                  setSecoes((atuais) => [...atuais, { titulo: '', texto: '', chave: proximaChave }])
+                  setProximaChave((chave) => chave + 1)
+                }}
+                className={BOTAO_SECUNDARIO}
+              >
+                <Plus strokeWidth={1.8} className="size-4" aria-hidden />
+                {rotulos.adicionar}
+              </button>
+              <span className="text-sm text-al-muted">{rotulos.dica}</span>
+            </div>
+          </fieldset>
+
+          {erro && <Mensagem tipo="erro">{erro}</Mensagem>}
+          <div className="flex justify-end gap-2">
+            <button type="button" disabled={enviando} onClick={aoFechar} className={BOTAO_SECUNDARIO}>
+              Cancelar
+            </button>
+            <button type="submit" disabled={enviando} className={BOTAO_PRIMARIO}>
+              {enviando ? 'Enviando…' : 'Enviar para aprovação'}
+            </button>
+          </div>
+        </form>
+      </DialogContent>
+    </Dialog>
+  )
+}
