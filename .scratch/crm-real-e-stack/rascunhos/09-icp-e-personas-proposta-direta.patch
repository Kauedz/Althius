+// A Memória do Workspace operacional, no Supabase (CRM-09): o ICP e as Personas vigentes, um de cada por Workspace, e
+// as revisões propostas pelos participantes. Tudo passa pelas funções do banco, que conferem a Participação ativa: todo
+// participante lê e propõe, e só um Administrador ativo aprova ou recusa. Aprovar substitui o documento vigente na
+// mesma transação da decisão. Enquanto o Scopus e o Ethos não rodam neste Workspace, quem escreve a proposta é o
+// participante; nenhum roteiro de Agente responde por aqui.
+
+import type { SupabaseClient } from '@supabase/supabase-js'
+import { diaIso } from './formatar-data'
+import { ERRO_SEM_PARTICIPACAO } from './regras'
+import { DOCUMENTOS_DA_MEMORIA, ERRO_REVISAO_JA_DECIDIDA, ERRO_SO_ADMINISTRADOR_DECIDE_REVISAO } from './regras-memoria'
+import type {
+  Decisao,
+  DocumentoDaMemoria,
+  DocumentoVigente,
+  FonteDeAgentes,
+  MemoriaDoWorkspace,
+  RevisaoDoParticipante,
+  SecaoDoDocumento,
+} from './tipos'
+
+interface RegistroDoDocumento {
+  document: DocumentoDaMemoria
+  sections: SecaoDoDocumento[]
+  approved_at: string
+  approved_by: string | null
+  approved_by_name: string
+}
+
+interface RegistroDaRevisao {
+  id: string
+  document: DocumentoDaMemoria
+  status: 'pendente' | 'aprovada' | 'recusada'
+  request: string
+  proposed_sections: SecaoDoDocumento[] | null
+  requested_by: string | null
+  requested_by_name: string
+  requested_at: string
+  decided_by: string | null
+  decided_by_name: string | null
+}
+
+const DECISAO_NO_BANCO: Record<Decisao, 'aprovada' | 'recusada'> = { aprovada: 'aprovada', rejeitada: 'recusada' }
+
+/** Uma recusa das funções do banco: o SQLSTATE, o trecho da mensagem que a identifica e o texto para a pessoa. */
+type Recusa = [code: string, trecho: string, texto: (documento?: DocumentoDaMemoria) => string]
+
+/** As recusas das funções da Memória do Workspace (migration memoria_do_workspace), num só lugar. */
+const RECUSAS: Recusa[] = [
+  ['42501', 'only administrators decide', () => ERRO_SO_ADMINISTRADOR_DECIDE_REVISAO],
+  ['42501', 'active workspace membership required', () => ERRO_SEM_PARTICIPACAO],
+  [
+    '23505',
+    'pending revision already exists',
+    (documento) =>
+      `Já existe uma proposta ${documento ? DOCUMENTOS_DA_MEMORIA[documento].comArtigo : 'deste documento'} pendente. Aguarde a decisão de um Administrador.`,
+  ],
+  ['22023', 'invalid request', () => 'Conte por que propõe esta mudança.'],
+  [
+    '22023',
+    'invalid sections',
+    () => 'Revise as seções: cada uma precisa de título (até 120 caracteres) e texto (até 4.000), sem títulos repetidos.',
+  ],
+  ['22023', 'does not change the document', () => 'A proposta é igual ao documento vigente. Mude alguma seção antes de enviar.'],
+  ['22023', 'revision already decided', () => ERRO_REVISAO_JA_DECIDIDA],
+  ['P0002', 'revision not found', () => 'Esta proposta não existe mais. Recarregue a página.'],
+]
+
+/** A mensagem para a pessoa; uma falha que não é recusa (rede, servidor) vira `falha`, sem o erro técnico. */
+function converterErro(error: { message: string; code?: string }, falha: string, documento?: DocumentoDaMemoria): Error {
+  const recusa = RECUSAS.find(([code, trecho]) => error.code === code && error.message.includes(trecho))
+  return new Error(recusa ? recusa[2](documento) : falha)
+}
+
+const FALHA_AO_CARREGAR = 'Não foi possível carregar a Memória do Workspace. Verifique sua conexão e tente de novo.'
+const FALHA_AO_PROPOR = 'Não foi possível enviar a proposta agora. Nada foi alterado; verifique sua conexão e tente de novo.'
+const FALHA_AO_DECIDIR = 'Não foi possível registrar a decisão agora. Nada mudou; verifique sua conexão e tente de novo.'
+
+const dia = (instante: string) => diaIso(new Date(instante))
+
+function documentoVigente(registro: RegistroDoDocumento | undefined): DocumentoVigente | null {
+  if (!registro) return null
+  return {
+    secoes: registro.sections,
+    aprovadoEm: dia(registro.approved_at),
+    aprovadoPor: { contaId: registro.approved_by ?? '', nome: registro.approved_by_name },
+  }
+}
+
+export type FonteDaMemoria = Pick<
+  FonteDeAgentes,
+  'observar' | 'memoriaDoWorkspace' | 'revisoesDaMemoria' | 'proporRevisao' | 'decidirRevisao'
+>
+
+export function criarFonteDaMemoriaSupabase(cliente: SupabaseClient, workspaceId: string): FonteDaMemoria {
+  const ouvintes = new Set<() => void>()
+  const avisar = () => ouvintes.forEach((ouvinte) => ouvinte())
+
+  async function memoriaDoWorkspace(): Promise<MemoriaDoWorkspace> {
+    const { data, error } = await cliente.rpc('get_workspace_memory', { p_workspace_id: workspaceId })
+    if (error) throw converterErro(error, FALHA_AO_CARREGAR)
+    const registros = (data ?? []) as RegistroDoDocumento[]
+    return {
+      icp: documentoVigente(registros.find((r) => r.document === 'icp')),
+      personas: documentoVigente(registros.find((r) => r.document === 'personas')),
+    }
+  }
+
+  return {
+    observar(ouvinte) {
+      ouvintes.add(ouvinte)
+      return () => ouvintes.delete(ouvinte)
+    },
+
+    memoriaDoWorkspace,
+
+    async revisoesDaMemoria(): Promise<RevisaoDoParticipante[]> {
+      const [memoria, { data, error }] = await Promise.all([
+        memoriaDoWorkspace(),
+        cliente.rpc('list_workspace_memory_revisions', { p_workspace_id: workspaceId }),
+      ])
+      if (error) throw converterErro(error, FALHA_AO_CARREGAR)
+      return ((data ?? []) as RegistroDaRevisao[]).map((registro): RevisaoDoParticipante => {
+        const base = {
+          id: registro.id,
+          documento: registro.document,
+          pedido: registro.request,
+          pedidaEm: dia(registro.requested_at),
+          solicitante: { contaId: registro.requested_by ?? '', nome: registro.requested_by_name },
+        }
+        if (registro.status === 'pendente') {
+          // Só uma proposta fica pendente por documento, e o vigente só muda pela decisão dela: o vigente de agora é o
+          // do pedido.
+          return {
+            ...base,
+            estado: 'pendente',
+            proposto: registro.proposed_sections ?? [],
+            vigenteNoPedido: memoria[registro.document]?.secoes ?? [],
+          }
+        }
+        return {
+          ...base,
+          estado: registro.status === 'aprovada' ? 'aprovada' : 'rejeitada',
+          decididaPor: { contaId: registro.decided_by ?? '', nome: registro.decided_by_name ?? '' },
+        }
+      })
+    },
+
+    async proporRevisao(documento, { pedido, secoes }) {
+      const { error } = await cliente.rpc('propose_workspace_memory_revision', {
+        p_workspace_id: workspaceId,
+        p_document: documento,
+        p_request: pedido.trim(),
+        p_sections: secoes.map(({ titulo, texto }) => ({ titulo: titulo.trim(), texto: texto.trim() })),
+      })
+      if (error) throw converterErro(error, FALHA_AO_PROPOR, documento)
+      avisar()
+    },
+
+    async decidirRevisao(revisaoId, decisao) {
+      const { error } = await cliente.rpc('decide_workspace_memory_revision', {
+        p_revision_id: revisaoId,
+        p_decision: DECISAO_NO_BANCO[decisao],
+      })
+      if (error) throw converterErro(error, FALHA_AO_DECIDIR)
+      avisar()
+    },
+  }
+}
