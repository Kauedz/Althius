+  0, 'recusada, a proposta não muda a Memória do Workspace');
+select is(
+  (select status || ' · ' || decided_by_name || ' · ' || (proposed_sections is null)::text
+     from public.list_workspace_memory_revisions('ffffffff-0000-0000-0000-000000000001')
+     where id = current_setting('teste.personas_1')::uuid),
+  'recusada · Ana Lima · true', 'a recusa fica registrada, sem o conteúdo recusado');
+
+-- A Administradora propõe e aprova a própria revisão: a segunda aprovação substitui a primeira.
+select throws_ok(
+  $$select public.propose_workspace_memory_revision('ffffffff-0000-0000-0000-000000000001', 'icp', 'Nada muda',
+      '[{"titulo":"Segmentos","texto":"Varejo"},{"titulo":"Porte","texto":"200 a 2.000 funcionários"}]')$$,
+  '22023', 'the proposal does not change the document', 'uma proposta igual ao vigente é recusada');
+select ok(
+  set_config('teste.icp_2', public.propose_workspace_memory_revision(
+    'ffffffff-0000-0000-0000-000000000001', 'icp', 'Incluir o atacado.',
+    '[{"titulo":"Segmentos","texto":"Varejo e atacado"}]'
+  )::text, true) is not null,
+  'a Administradora propõe outro ICP');
+select lives_ok(
+  $$select public.decide_workspace_memory_revision(current_setting('teste.icp_2')::uuid, 'aprovada')$$,
+  'a Administradora aprova a própria proposta; basta uma decisão');
+reset role;
+select is(
+  (select count(*)::int from private.workspace_memory_documents
+     where workspace_id = 'ffffffff-0000-0000-0000-000000000001' and document = 'icp'),
+  1, 'o Workspace continua com um só ICP: a aprovação substitui o vigente');
+select is(
+  (select sections from public.get_workspace_memory('ffffffff-0000-0000-0000-000000000001') where document = 'icp'),
+  '[{"titulo":"Segmentos","texto":"Varejo e atacado"}]'::jsonb,
+  'o vigente é o último aprovado, e o anterior não fica guardado em lugar nenhum');
+select is(
+  (select count(*)::int from private.workspace_memory_revisions
+     where workspace_id = 'ffffffff-0000-0000-0000-000000000001' and proposed_sections is not null),
+  0, 'nenhuma revisão decidida guarda conteúdo: não há histórico de documentos');
+set local role authenticated;
+
+-- Bruno, Membro, lê o mesmo documento vigente: é uma configuração do Workspace, não uma cópia por participante.
+select set_config('request.jwt.claim.sub', '60000000-0000-0000-0000-000000000002', true);
+select is(
+  (select sections from public.get_workspace_memory('ffffffff-0000-0000-0000-000000000001') where document = 'icp'),
+  '[{"titulo":"Segmentos","texto":"Varejo e atacado"}]'::jsonb,
+  'o Membro lê o mesmo ICP vigente que a Administradora aprovou');
+select is(
+  (select string_agg(status, ',' order by requested_at desc)
+     from public.list_workspace_memory_revisions('ffffffff-0000-0000-0000-000000000001')),
+  'aprovada,recusada,aprovada', 'o Membro consulta as revisões e as decisões, da mais nova para a mais antiga');
+
+-- Carla, Administradora de outro Workspace: não lê nem decide nada do Norte.
+select set_config('request.jwt.claim.sub', '60000000-0000-0000-0000-000000000003', true);
+select throws_ok(
+  $$select * from public.get_workspace_memory('ffffffff-0000-0000-0000-000000000001')$$,
+  '42501', 'active workspace membership required', 'a Administradora de outro Workspace não lê o ICP do Norte');
+select throws_ok(
+  $$select * from public.list_workspace_memory_revisions('ffffffff-0000-0000-0000-000000000001')$$,
+  '42501', 'active workspace membership required', 'nem as revisões do Norte');
+select ok(
+  set_config('teste.sul_1', public.propose_workspace_memory_revision(
+    'ffffffff-0000-0000-0000-000000000002', 'icp', 'Primeiro ICP do Sul.', '[{"titulo":"Segmentos","texto":"Agro"}]'
+  )::text, true) is not null,
+  'a Carla propõe o ICP do próprio Workspace');
+select is(
+  (select count(*)::int from public.get_workspace_memory('ffffffff-0000-0000-0000-000000000002')),
+  0, 'o ICP aprovado no Norte não aparece no Sul');
+
+select set_config('request.jwt.claim.sub', '60000000-0000-0000-0000-000000000001', true);
+select throws_ok(
+  $$select public.decide_workspace_memory_revision(current_setting('teste.sul_1')::uuid, 'aprovada')$$,
+  '42501', 'active workspace membership required', 'a Administradora do Norte não decide uma revisão do Sul');
+
+-- Diego não participa de nada.
+select set_config('request.jwt.claim.sub', '60000000-0000-0000-0000-000000000004', true);
+select throws_ok(
+  $$select * from public.get_workspace_memory('ffffffff-0000-0000-0000-000000000001')$$,
+  '42501', 'active workspace membership required', 'quem não participa não lê a Memória do Workspace');
+
+-- Nada se lê direto nas tabelas pela API.
+select throws_ok(
+  $$select count(*) from private.workspace_memory_documents$$,
+  '42501', 'permission denied for schema private', 'os documentos não são lidos direto pela API');
+
+-- Sem login, nenhuma função responde.
+reset role;
+set local role anon;
+select set_config('request.jwt.claim.role', 'anon', true);
+select set_config('request.jwt.claim.sub', '', true);
+select throws_ok(
+  $$select * from public.get_workspace_memory('ffffffff-0000-0000-0000-000000000001')$$,
+  '42501', 'permission denied for function get_workspace_memory', 'sem login, a Memória do Workspace não é lida');
+select throws_ok(
+  $$select public.propose_workspace_memory_revision('ffffffff-0000-0000-0000-000000000001', 'icp', 'Motivo',
+      '[{"titulo":"A","texto":"B"}]')$$,
+  '42501', 'permission denied for function propose_workspace_memory_revision', 'sem login, ninguém propõe');
+reset role;
+
+-- A auditoria registra cada proposta e cada decisão, com o autor, na ordem em que aconteceram.
+select is(
+  (select string_agg(e.event || ':' || e.document || ':' || u.email, ', ' order by e.id)
+     from private.workspace_memory_events e join auth.users u on u.id = e.actor_user_id
+     where e.workspace_id = 'ffffffff-0000-0000-0000-000000000001'),
+  'revisao_proposta:icp:bruno@norte.com.br, revisao_proposta:personas:bruno@norte.com.br, '
+  'revisao_aprovada:icp:ana@norte.com.br, revisao_recusada:personas:ana@norte.com.br, '
+  'revisao_proposta:icp:ana@norte.com.br, revisao_aprovada:icp:ana@norte.com.br',
+  'a auditoria tem as propostas e as decisões do Norte, com quem fez cada uma');
+select is(
+  (select count(*)::int from private.workspace_memory_events where workspace_id = 'ffffffff-0000-0000-0000-000000000002'),
+  1, 'a auditoria do Sul é separada da do Norte');
+select is(
+  (select revision_id::text from private.workspace_memory_documents
+     where workspace_id = 'ffffffff-0000-0000-0000-000000000001' and document = 'icp'),
+  current_setting('teste.icp_2'), 'o documento vigente aponta para a revisão que o publicou');
+
+select * from finish();
+rollback;
