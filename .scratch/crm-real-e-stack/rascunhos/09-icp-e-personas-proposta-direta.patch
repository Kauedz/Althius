@@ -0,0 +1,281 @@
+-- ICP e Personas do Workspace (CRM-09, ADR 0010).
+-- A Memória do Workspace guarda um documento vigente por Workspace para o ICP e outro para as definições de Personas:
+-- configuração compartilhada, lida por todos os participantes ativos, e nunca uma cópia por participante. Um documento
+-- só muda por uma revisão proposta e aprovada: qualquer participante ativo propõe, e só um Administrador ativo aprova
+-- ou recusa, validado aqui, também quando foi ele quem propôs. Aprovar substitui o documento vigente na mesma
+-- transação que registra a decisão; recusar não toca nele. Não há histórico de documentos: a revisão decidida guarda só
+-- o registro (pedido, quem pediu, quem decidiu e quando), e o conteúdo proposto sai dela na decisão. Toda proposta e
+-- toda decisão também entram em workspace_memory_events, para auditoria. A identidade vem sempre de auth.uid().
+--
+-- Enquanto os Agentes não rodam no Workspace operacional, quem escreve a proposta é o participante; quando o Scopus e o
+-- Ethos tiverem backend, as propostas deles entram pela mesma tabela e pela mesma decisão.
+
+create table private.workspace_memory_revisions (
+  id uuid primary key default gen_random_uuid(),
+  workspace_id uuid not null references public.workspaces(id) on delete cascade,
+  document text not null check (document in ('icp', 'personas')),
+  status text not null default 'pendente' check (status in ('pendente', 'aprovada', 'recusada')),
+  -- O motivo da proposta, como quem a fez o escreveu.
+  request text not null check (request = btrim(request) and length(request) between 1 and 2000),
+  -- O documento inteiro como ficaria. Só enquanto pendente: decidida, a revisão não guarda conteúdo.
+  proposed_sections jsonb check (jsonb_typeof(proposed_sections) = 'array'),
+  requested_by uuid references auth.users(id) on delete set null,
+  -- O nome de quem pediu e de quem decidiu, como era no momento.
+  requested_by_name text not null,
+  requested_at timestamptz not null default clock_timestamp(),
+  decided_by uuid references auth.users(id) on delete set null,
+  decided_by_name text,
+  decided_at timestamptz,
+  check ((status = 'pendente') = (proposed_sections is not null)),
+  check ((status = 'pendente') = (decided_at is null)),
+  check ((status = 'pendente') = (decided_by_name is null))
+);
+
+-- No máximo uma proposta pendente por documento em cada Workspace; ICP e Personas são independentes.
+create unique index workspace_memory_revisions_one_pending
+  on private.workspace_memory_revisions (workspace_id, document) where status = 'pendente';
+create index workspace_memory_revisions_workspace_idx on private.workspace_memory_revisions (workspace_id, requested_at);
+create index workspace_memory_revisions_requested_by_idx on private.workspace_memory_revisions (requested_by);
+create index workspace_memory_revisions_decided_by_idx on private.workspace_memory_revisions (decided_by);
+
+-- O documento vigente: um por Workspace e documento, substituído a cada aprovação.
+create table private.workspace_memory_documents (
+  workspace_id uuid not null references public.workspaces(id) on delete cascade,
+  document text not null check (document in ('icp', 'personas')),
+  sections jsonb not null check (jsonb_typeof(sections) = 'array' and jsonb_array_length(sections) > 0),
+  approved_at timestamptz not null,
+  approved_by uuid references auth.users(id) on delete set null,
+  approved_by_name text not null,
+  -- A revisão cuja aprovação publicou este documento.
+  revision_id uuid references private.workspace_memory_revisions(id) on delete set null,
+  primary key (workspace_id, document)
+);
+
+create index workspace_memory_documents_approved_by_idx on private.workspace_memory_documents (approved_by);
+create index workspace_memory_documents_revision_idx on private.workspace_memory_documents (revision_id);
+
+-- A auditoria das propostas e decisões, só de acréscimo.
+create table private.workspace_memory_events (
+  id bigint generated always as identity primary key,
+  workspace_id uuid not null references public.workspaces(id) on delete cascade,
+  revision_id uuid not null references private.workspace_memory_revisions(id) on delete cascade,
+  document text not null check (document in ('icp', 'personas')),
+  event text not null check (event in ('revisao_proposta', 'revisao_aprovada', 'revisao_recusada')),
+  actor_user_id uuid references auth.users(id) on delete set null,
+  created_at timestamptz not null default clock_timestamp()
+);
+
+create index workspace_memory_events_workspace_idx on private.workspace_memory_events (workspace_id, created_at);
+create index workspace_memory_events_revision_idx on private.workspace_memory_events (revision_id);
+create index workspace_memory_events_actor_idx on private.workspace_memory_events (actor_user_id);
+
+alter table private.workspace_memory_revisions enable row level security;
+alter table private.workspace_memory_documents enable row level security;
+alter table private.workspace_memory_events enable row level security;
+revoke all on private.workspace_memory_revisions from public, anon, authenticated;
+revoke all on private.workspace_memory_documents from public, anon, authenticated;
+revoke all on private.workspace_memory_events from public, anon, authenticated;
+
+-- O nome com que a Conta de usuário aparece: o de Meu perfil, o do cadastro ou, sem nenhum, o e-mail.
+create function private.memory_author_name(p_user_id uuid)
+returns text
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select coalesce(p.display_name, private.registered_name(u.raw_user_meta_data), u.email::text)
+  from auth.users u
+  left join private.user_profiles p on p.user_id = u.id
+  where u.id = p_user_id;
+$$;
+
+-- As seções de um documento, conferidas e sem espaços nas pontas: de 1 a 30, cada uma com título (até 120
+-- caracteres) e texto (até 4.000), sem dois títulos iguais.
+create function private.normalize_memory_sections(p_sections jsonb)
+returns jsonb
+language plpgsql
+immutable
+set search_path = ''
+as $$
+declare
+  v_item jsonb;
+  v_title text;
+  v_text text;
+  v_titles text[] := '{}';
+  v_result jsonb := '[]'::jsonb;
+begin
+  if p_sections is null or jsonb_typeof(p_sections) <> 'array' or jsonb_array_length(p_sections) not between 1 and 30 then
+    raise exception 'invalid sections' using errcode = '22023';
+  end if;
+  for v_item in select e.value from jsonb_array_elements(p_sections) with ordinality e order by e.ordinality loop
+    if jsonb_typeof(v_item) <> 'object'
+       or jsonb_typeof(v_item -> 'titulo') is distinct from 'string'
+       or jsonb_typeof(v_item -> 'texto') is distinct from 'string' then
+      raise exception 'invalid sections' using errcode = '22023';
+    end if;
+    v_title := btrim(v_item ->> 'titulo');
+    v_text := btrim(v_item ->> 'texto');
+    if length(v_title) not between 1 and 120 or length(v_text) not between 1 and 4000 or lower(v_title) = any (v_titles) then
+      raise exception 'invalid sections' using errcode = '22023';
+    end if;
+    v_titles := v_titles || lower(v_title);
+    v_result := v_result || jsonb_build_array(jsonb_build_object('titulo', v_title, 'texto', v_text));
+  end loop;
+  return v_result;
+end;
+$$;
+
+revoke all on function private.memory_author_name(uuid) from public, anon, authenticated;
+revoke all on function private.normalize_memory_sections(jsonb) from public, anon, authenticated;
+
+-- Os documentos vigentes do Workspace, que todo participante ativo lê. Um documento ainda não aprovado não vem.
+create function public.get_workspace_memory(p_workspace_id uuid)
+returns table (document text, sections jsonb, approved_at timestamptz, approved_by uuid, approved_by_name text)
+language plpgsql
+stable
+security definer
+set search_path = ''
+as $$
+begin
+  perform private.require_active_membership(p_workspace_id);
+  return query
+    select d.document, d.sections, d.approved_at, d.approved_by, d.approved_by_name
+    from private.workspace_memory_documents d
+    where d.workspace_id = p_workspace_id
+    order by d.document;
+end;
+$$;
+
+-- As revisões do Workspace, da mais nova para a mais antiga, que todo participante ativo consulta. Só a pendente traz
+-- o conteúdo proposto.
+create function public.list_workspace_memory_revisions(p_workspace_id uuid)
+returns table (
+  id uuid, document text, status text, request text, proposed_sections jsonb,
+  requested_by uuid, requested_by_name text, requested_at timestamptz,
+  decided_by uuid, decided_by_name text, decided_at timestamptz
+)
+language plpgsql
+stable
+security definer
+set search_path = ''
+as $$
+begin
+  perform private.require_active_membership(p_workspace_id);
+  return query
+    select r.id, r.document, r.status, r.request, r.proposed_sections,
+      r.requested_by, r.requested_by_name, r.requested_at,
+      r.decided_by, r.decided_by_name, r.decided_at
+    from private.workspace_memory_revisions r
+    where r.workspace_id = p_workspace_id
+    order by r.requested_at desc, r.id;
+end;
+$$;
+
+-- Qualquer participante ativo propõe um documento inteiro, com o motivo. O vigente não muda até a decisão. Devolve o
+-- id da revisão pendente.
+create function public.propose_workspace_memory_revision(
+  p_workspace_id uuid, p_document text, p_request text, p_sections jsonb
+)
+returns uuid
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_request text := btrim(coalesce(p_request, ''));
+  v_sections jsonb;
+  v_id uuid;
+begin
+  perform private.require_active_membership(p_workspace_id);
+  if p_document is null or p_document not in ('icp', 'personas') then
+    raise exception 'invalid document' using errcode = '22023';
+  end if;
+  if length(v_request) not between 1 and 2000 then
+    raise exception 'invalid request' using errcode = '22023';
+  end if;
+  v_sections := private.normalize_memory_sections(p_sections);
+  if exists (
+    select 1 from private.workspace_memory_documents d
+    where d.workspace_id = p_workspace_id and d.document = p_document and d.sections = v_sections
+  ) then
+    raise exception 'the proposal does not change the document' using errcode = '22023';
+  end if;
+
+  begin
+    insert into private.workspace_memory_revisions (workspace_id, document, request, proposed_sections, requested_by, requested_by_name)
+    values (p_workspace_id, p_document, v_request, v_sections, v_user_id, private.memory_author_name(v_user_id))
+    returning id into v_id;
+  exception when unique_violation then
+    raise exception 'a pending revision already exists for this document' using errcode = '23505';
+  end;
+
+  insert into private.workspace_memory_events (workspace_id, revision_id, document, event, actor_user_id)
+  values (p_workspace_id, v_id, p_document, 'revisao_proposta', v_user_id);
+  return v_id;
+end;
+$$;
+
+-- Só um Administrador ativo do Workspace da revisão decide; basta um, e pode ser quem propôs. Aprovar substitui o
+-- documento vigente na mesma transação da decisão; recusar não toca nele. Nos dois casos, o conteúdo proposto sai da
+-- revisão, que fica só como registro.
+create function public.decide_workspace_memory_revision(p_revision_id uuid, p_decision text)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_user_id uuid := auth.uid();
+  v_revision private.workspace_memory_revisions;
+  v_name text;
+begin
+  if v_user_id is null then
+    raise exception 'authentication required' using errcode = '42501';
+  end if;
+  if p_decision is null or p_decision not in ('aprovada', 'recusada') then
+    raise exception 'invalid decision' using errcode = '22023';
+  end if;
+  select * into v_revision from private.workspace_memory_revisions r where r.id = p_revision_id for update;
+  if not found then
+    raise exception 'revision not found' using errcode = 'P0002';
+  end if;
+  if private.require_active_membership(v_revision.workspace_id) <> 'admin' then
+    raise exception 'only administrators decide memory revisions' using errcode = '42501';
+  end if;
+  if v_revision.status <> 'pendente' then
+    raise exception 'revision already decided' using errcode = '22023';
+  end if;
+
+  v_name := private.memory_author_name(v_user_id);
+  if p_decision = 'aprovada' then
+    insert into private.workspace_memory_documents as d
+      (workspace_id, document, sections, approved_at, approved_by, approved_by_name, revision_id)
+    values (v_revision.workspace_id, v_revision.document, v_revision.proposed_sections, clock_timestamp(), v_user_id, v_name,
+            v_revision.id)
+    on conflict (workspace_id, document) do update
+      set sections = excluded.sections, approved_at = excluded.approved_at, approved_by = excluded.approved_by,
+          approved_by_name = excluded.approved_by_name, revision_id = excluded.revision_id;
+  end if;
+
+  update private.workspace_memory_revisions r
+  set status = p_decision, proposed_sections = null, decided_by = v_user_id, decided_by_name = v_name,
+      decided_at = clock_timestamp()
+  where r.id = v_revision.id;
+
+  insert into private.workspace_memory_events (workspace_id, revision_id, document, event, actor_user_id)
+  values (v_revision.workspace_id, v_revision.id, v_revision.document,
+          case p_decision when 'aprovada' then 'revisao_aprovada' else 'revisao_recusada' end, v_user_id);
+end;
+$$;
+
+revoke all on function public.get_workspace_memory(uuid) from public, anon;
+revoke all on function public.list_workspace_memory_revisions(uuid) from public, anon;
+revoke all on function public.propose_workspace_memory_revision(uuid, text, text, jsonb) from public, anon;
+revoke all on function public.decide_workspace_memory_revision(uuid, text) from public, anon;
+
+grant execute on function public.get_workspace_memory(uuid) to authenticated;
+grant execute on function public.list_workspace_memory_revisions(uuid) to authenticated;
+grant execute on function public.propose_workspace_memory_revision(uuid, text, text, jsonb) to authenticated;
+grant execute on function public.decide_workspace_memory_revision(uuid, text) to authenticated;
