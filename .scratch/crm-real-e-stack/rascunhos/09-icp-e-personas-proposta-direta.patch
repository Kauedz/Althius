+/** Uma recusa do banco, com o SQLSTATE e a mensagem que a função levanta. */
+function recusa(code: string, message: string) {
+  return Object.assign(new Error(message), { code })
+}
+
+type Secoes = { titulo: string; texto: string }[]
+interface DocumentoNoBanco { document: string; sections: Secoes; approved_at: string; approved_by: string; approved_by_name: string }
+interface RevisaoNoBanco {
+  id: string
