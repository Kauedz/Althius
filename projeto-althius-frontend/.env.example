VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Opcional: Client ID Web do Google Cloud para "Continuar com Google" (botao e One Tap). Sem ele, o Google nao aparece.
# O mesmo Client ID vai no provedor Google do Supabase Auth. Nao e segredo, mas nunca coloque aqui o Client Secret.
VITE_GOOGLE_CLIENT_ID=
# Site key pública do Cloudflare Turnstile (CAPTCHA invisível) para login (senha, código e Google), cadastro por convite e
# redefinição de senha. Opcional: vazia, nenhum token é pedido. Ligue a chave aqui e no Supabase Auth ao mesmo tempo.
# A chave secreta fica só no Supabase Auth (Authentication > Attack Protection > CAPTCHA), nunca aqui.
VITE_TURNSTILE_SITE_KEY=
